set sort              = threads
set strict_threads    = no
set pager_stop        = yes
set pager_index_lines = 0
set auto_edit         = yes      # neomutt

set edit_headers      = yes      # neomutt

set include           = yes
set fast_reply        = yes

set mark_old          = no

auto_view text/html
alternative_order text/enriched text/plain text text/html

set ssl_starttls=yes
set ssl_force_tls=yes

set wrap=80

source neomuttrc.theme

# include private/local config
source neomuttrc.local
